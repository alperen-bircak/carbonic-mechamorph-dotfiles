// Like sudo's timestamp: let run0 skip the password for 15 minutes in a
// terminal where `run0k` last succeeded. run0k touches
// /run/run0-grace/<terminal id> as root (only root can write to /run, and it's
// cleared at reboot); /usr/local/bin/run0-terminal works out the ID from the
// calling process. Only for wheel users in a local, active session.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.systemd1.manage-units" ||
        !subject.isInGroup("wheel") || !subject.local || !subject.active)
        return;
    try {
        var id = polkit.spawn(["/usr/local/bin/run0-terminal", String(subject.pid)]).trim();
        if (!/^[0-9]+-[0-9]+$/.test(id))
            return;
        var recent = polkit.spawn(["/usr/bin/find", "/run/run0-grace/" + id,
                                   "-maxdepth", "0", "-mmin", "-15"]);
        if (recent.trim() != "")
            return polkit.Result.YES;
    } catch (e) {
        // Not unlocked in this terminal yet: fall through to the password prompt
    }
});
