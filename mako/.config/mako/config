# Dismiss notifications after 5s (mako default is never)
default-timeout=5000

font=Fira Code 10
padding=10
border-size=0
border-radius=0
icons=0

# Colours. After the global options, because the file ends in an [urgency=...] section.
include=~/.config/theme/mako.conf

# Screenshots (bin/.local/bin/screenshot) show the picture itself, the only notifications with an image
[app-name=screenshot]
icons=1
max-icon-size=128
