# Ayu light, built from the ayu palette v9.1.0 (npm "ayu", dist/generated/light.js).
# ANSI colors come from its `terminal` block, except black: upstream #86878c is lighter
# than the normal text, so text printed in "black" ends up fainter than plain text.

# black: editor.fg (upstream #86878c)
palette = 0=#5c6166
palette = 1=#f07171
palette = 2=#86b300
palette = 3=#eba400
palette = 4=#22a4e6
palette = 5=#a37acc
palette = 6=#4cbf99
palette = 7=#adaeb1
palette = 8=#939498
palette = 9=#f07171
palette = 10=#86b300
palette = 11=#eba400
palette = 12=#22a4e6
palette = 13=#a37acc
palette = 14=#4cbf99
palette = 15=#c5c5c8

# ui.bg / surface.base
background = #f8f9fa
# editor.fg
foreground = #5c6166
# common.accent.tint
cursor-color = #f29718
cursor-text = #f8f9fa
# editor.selection.active (#035bd626) blended over the background
selection-background = #d3e1f5
