# Ayu dark, built from the ayu palette v9.1.0 (npm "ayu", dist/generated/dark.js).
# ANSI colors come from its `terminal` block, except black/brightBlack: upstream sets
# both to #0a0000, which makes dim text (prompt hints, autosuggestions) unreadable.

# black: surface.lift / editor.bg
palette = 0=#10141c
palette = 1=#e6495a
palette = 2=#97c142
palette = 3=#e89d37
palette = 4=#17acf2
palette = 5=#c385fe
palette = 6=#84ceb5
# white: editor.fg (upstream #ffffff)
palette = 7=#bfbdb6
# brightBlack: syntax.comment
palette = 8=#5a6673
palette = 9=#f07178
palette = 10=#aad94c
palette = 11=#ffb454
palette = 12=#59c2ff
palette = 13=#d2a6ff
palette = 14=#95e6cb
palette = 15=#ffffff

# ui.bg / surface.base
background = #0d1017
# editor.fg
foreground = #bfbdb6
# common.accent.tint
cursor-color = #e6b450
cursor-text = #0d1017
# editor.selection.active (#3388ff40) blended over the background
selection-background = #172e51
