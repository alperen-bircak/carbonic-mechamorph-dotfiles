# Ayu Carbon: what `theme-switch` applies. Hand-written; `just theme-generate` leaves it alone.
# Wallpaper and cursor are in desktop.conf, because sway reads them.
COLOR_SCHEME=prefer-dark
GTK_THEME_NAME=Adwaita-dark
ICON_THEME=pixelitos-dark
NVIM_COLORSCHEME=ayu-dark
FZF_COLORS=dark
WAYBAR_ICON=󰖔
