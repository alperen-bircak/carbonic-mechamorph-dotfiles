# ayu colors: a palette page and a colour lookup script, both reading the
# `ayu` npm package. Node comes from nvm (see .nvmrc); falls back to the
# system node if nvm isn't installed.

set shell := ["bash", "-c"]

node := 'if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then source "${NVM_DIR:-$HOME/.nvm}/nvm.sh" && nvm use --silent >/dev/null; fi;'

# List recipes
default:
    @just --list

# Look up colours, e.g. `just color dark syntax.keyword` (`just color --help`)
[positional-arguments]
color *args: _deps
    @{{node}} node scripts/ayu-color.ts "$@"

# Start the dev server and open it in the browser
dev: _deps
    {{node}} npx vite --open

# Build a static copy into dist/
build: _deps
    {{node}} npm run build

# Build, then serve dist/ and open it (the fast way to see the page)
app: build
    {{node}} npx vite preview --open

# Type-check the page and the script
check: _deps
    {{node}} npm run typecheck

# Update the ayu package to its latest release
update: _deps
    {{node}} npm install ayu@latest

# Install dependencies
install:
    {{node}} npm install

# Remove build output and dependencies
clean:
    rm -rf dist node_modules

# Install dependencies on first run
_deps:
    @[ -d node_modules ] || just install >&2
