// Ayu Carbon. $base00 and so on are in theme/.config/theme/rofi.rasi.

@import "~/.config/theme/rofi.rasi"

* {
    bg:       @base01;
    bg-alt:   @base00;
    fg:       @base05;
    fg-dim:   @base03;
    accent:   @base0D;
    selected: @base02;
    urgent:   @base0F;

    font: "Fira Code 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 36em;
    padding: 12px;
    background-color: @bg;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: 8px 10px;
    spacing: 8px;
    background-color: @bg-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @fg-dim;
}

entry {
    placeholder: "Search";
    placeholder-color: @fg-dim;
    cursor: text;
}

message {
    padding: 6px 10px;
    background-color: @bg-alt;
}

listview {
    lines: 8;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 6px 10px;
    spacing: 10px;
    cursor: pointer;
}

element selected.normal {
    background-color: @selected;
}

element normal.active,
element alternate.active,
element selected.active {
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: @urgent;
}

element-icon {
    size: 1.5em;
    vertical-align: 0.5;
    background-color: inherit;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
    cursor: inherit;
    // Matched letters
    highlight: bold;
}
