// fastfetch config (`fetch` in zsh). See `fastfetch --help config` and `fastfetch --list-modules`.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // fastfetch's own Arch logo, both of its colours in terminal blue, which the theme sets to the
    // indigo accent, so it follows the light/dark switch
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": { "1": "blue", "2": "blue" },
        "padding": { "top": 0, "left": 1, "right": 4 }
    },
    // Labels in muted grey (terminal colour 8, the theme's base03; "90" because fastfetch reads
    // "bright_black" as bold black, which is the background), not bold; values in the main text colour
    "display": {
        "separator": "  ",
        "brightColor": false,
        "color": { "keys": "90", "output": "default" },
        "key": { "width": 10 }
    },
    "modules": [
        { "type": "os", "key": "os" },
        { "type": "kernel", "key": "kernel" },
        { "type": "wm", "key": "wm" },
        { "type": "shell", "key": "shell" },
        { "type": "terminal", "key": "terminal" },
        "break",
        { "type": "cpu", "key": "cpu" },
        { "type": "memory", "key": "memory" },
        { "type": "disk", "key": "disk", "folders": "/" },
        { "type": "battery", "key": "battery" },
        "break",
        { "type": "uptime", "key": "uptime" },
        "break",
        // The active theme's 16 terminal colours (tinty sets them from Ayu): normal, then bright
        { "type": "colors", "symbol": "block" }
    ]
}
