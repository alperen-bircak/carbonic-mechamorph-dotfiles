#!/bin/bash
# Usage: battery-notify  (started from the sway config)
# Notify once each time the battery drops to 15%, 10% and 5%. Each notification stays until
# dismissed and replaces the one before it; plugging in clears it and resets the thresholds.
bat=/sys/class/power_supply/BAT0
last=101  # lowest threshold notified since the battery started discharging
id=0

while sleep 30; do
    read -r pct < "$bat/capacity" || continue
    read -r status < "$bat/status" || continue

    if [ "$status" != Discharging ]; then
        [ "$id" -ne 0 ] && makoctl dismiss -n "$id"
        last=101 id=0
        continue
    fi

    for threshold in 5 10 15; do
        if [ "$pct" -le "$threshold" ]; then
            if [ "$threshold" -lt "$last" ]; then
                urgency=critical
                [ "$threshold" -eq 15 ] && urgency=normal
                id=$(notify-send -p -r "$id" -t 0 -u "$urgency" -a battery "Battery low" "$pct% left")
                last=$threshold
            fi
            break
        fi
    done
done
