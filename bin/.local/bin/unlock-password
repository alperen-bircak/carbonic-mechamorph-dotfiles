#!/bin/sh
# Usage: unlock-password
# Clear the faillock counter, so a password locked out by failed tries (pam_faillock locks it
# after 3 for 10 minutes; a password popup closed without typing counts as one) works again.
# Needs no root: the counter file in /run/faillock is owned by the user.
if faillock --user "$USER" --reset; then
    notify-send -i changes-allow-symbolic "Password unlocked" "Failed login count cleared"
else
    notify-send -i dialog-error-symbolic "Couldn't unlock password" "faillock --reset failed"
fi
