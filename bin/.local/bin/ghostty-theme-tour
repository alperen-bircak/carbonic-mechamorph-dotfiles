#!/usr/bin/env bash
# Usage: ghostty-theme-tour [seconds per theme] [theme number to start at]
# Show every Ghostty theme in turn (reloading open windows), then settle on ayu-v9.
# Ctrl+C stops it early and also goes back to ayu-v9.
set -u

conf=~/dotfiles/ghostty/.config/ghostty/config.ghostty
final=$(python3 - "$conf" <<'EOF'
import re, sys
s = open(sys.argv[1]).read()
new = '''# Ayu dark from the v9.1.0 palette (themes/ayu-v9; light is themes/ayu-light-v9);
# built-in "Ayu" is the older one
theme = ayu-v9'''
# The two comment lines above the theme line, whichever theme is set now
s, n = re.subn(r'^#[^\n]*\n#[^\n]*\ntheme = [^\n]*$', lambda m: new, s, flags=re.M)
assert n == 1
sys.stdout.write(s)
EOF
) || exit 1

reload() { pkill -USR2 -x ghostty; }

finish() {
    printf '%s\n' "$final" > "$conf"
    reload
    notify-send -r "$id" -t 4000 'Ghostty theme tour' 'Done, back on ayu-v9'
    exit
}

themes=()
while IFS= read -r t; do themes+=("$t"); done < <(ls /usr/share/ghostty/themes)
themes+=(ayu-light-v9)

id=$(notify-send -p -t 1 'Ghostty theme tour' "${#themes[@]} themes")
trap finish EXIT INT TERM

delay=${1:-3}
start=${2:-1}

n=0
for t in "${themes[@]}"; do
    n=$((n + 1))
    [ "$n" -lt "$start" ] && continue
    sed -i "s|^theme = .*|theme = $t|" "$conf"
    reload
    id=$(notify-send -p -r "$id" -t "$(( delay * 1000 + 500 ))" "$t" "$n / ${#themes[@]}")
    echo "$n/${#themes[@]} $t"
    sleep "$delay"
done
