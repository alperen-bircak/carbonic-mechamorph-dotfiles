#!/bin/sh
# Usage: ephemeral-tui [-s COLSxROWS] NAME [COMMAND...]
# Open COMMAND (default: NAME) in a floating kitty window, or close it if it's already open.
# Waybar's module clicks use this. The window's app_id is tui.NAME: sway floats every tui.*
# window (for_window rule) and tui-autoclose closes them when you click something else.
# -s sets the window size in cells (default 100x28).
size=100x28
if [ "$1" = -s ]; then size=$2; shift 2; fi
cols=${size%x*} rows=${size#*x}
name=$1; shift
[ $# -eq 0 ] && set -- "$name"
app_id="tui.$name"

if swaymsg -t get_tree | jq -e --arg id "$app_id" '.. | objects | select(.app_id? == $id)' >/dev/null; then
    swaymsg -q "[app_id=\"^tui\\.$name\$\"] kill"
    exit 0
fi

if ! command -v "$1" >/dev/null; then
    notify-send "ephemeral-tui" "$1 isn't installed"
    exit 1
fi
# only a click elsewhere should close it, not hovering (tui-autoclose turns this back on)
swaymsg -q focus_follows_mouse no

# Size in cells instead of the remembered size of the last kitty window, and no
# "process still running" prompt when the window is closed.
exec kitty --class="$app_id" -o remember_window_size=no \
    -o initial_window_width="${cols}c" -o initial_window_height="${rows}c" \
    -o confirm_os_window_close=0 "$@"
