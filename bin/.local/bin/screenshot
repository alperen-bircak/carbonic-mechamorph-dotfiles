#!/bin/sh
# Usage: screenshot [area]  -- saves to ~/Pictures/Screenshots, copies to clipboard and notifies (with the picture)
# (Print for the whole screen, Shift+Print for a dragged area; Escape cancels the selection quietly)
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

if [ "$1" = area ]; then
    geom=$(slurp) || exit 0
    grim -g "$geom" "$file"
else
    grim "$file"
fi && wl-copy --type image/png < "$file" &&
    notify-send -a screenshot -i "$file" "Screenshot saved" "${file##*/}"
