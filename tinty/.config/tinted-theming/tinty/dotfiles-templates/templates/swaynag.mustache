# {{scheme-name}}: swaynag has no include, so its whole config is rendered here.
# sway's own types set their own colours, so warning and error are both replaced.
font=Fira Code 10

[warning]
background={{base01-hex}}
text={{base05-hex}}
border={{base02-hex}}
border-bottom={{base02-hex}}
border-bottom-size=0
button-background={{base02-hex}}
button-text={{base05-hex}}
button-border-size=0
details-background={{base00-hex}}

[error]
background={{base01-hex}}
text={{base0F-hex}}
border={{base02-hex}}
border-bottom={{base02-hex}}
border-bottom-size=0
button-background={{base02-hex}}
button-text={{base05-hex}}
button-border-size=0
details-background={{base00-hex}}
